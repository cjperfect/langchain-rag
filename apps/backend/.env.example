# =============================================================================
# langchain-rag · 后端环境变量模板
# 复制为 .env 后按需填写。所有变量均有代码默认值或显式标注，缺失不致命。
# 数据库（pgvector 镜像，见 docker/docker-compose.yml；账号/密码可自改）
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/langchain_rag"

# JWT 签名密钥（不填则代码回退 dev-secret-change-me，仅用于本地开发）
JWT_SECRET="change-me-to-a-long-random-string"

# =============================================================================
# LLM 问答（二选一）
# -----------------------------------------------------------------------------
# 方式 A：本地 Ollama（qwen3.5:0.8b，需本机运行 Ollama 并拉取模型）。
#   LLM_PROVIDER=ollama 时走 ChatOllama 原生 /api/chat，并关闭思考模式
#   （qwen3.5 默认思考会吃光 token 预算返回空内容）。
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=ollama        # 任意非空占位即可
# OLLAMA_MODEL=qwen3.5:0.8b
#
# 方式 B：OpenAI 兼容接口（DeepSeek / 火山方舟 / OpenAI 等）。
#   不设置 LLM_PROVIDER 即走 ChatOpenAI；LLM_BASE_URL 指向 /v1 或方舟 /api/v3。
#   方舟示例：LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   前端选中模型名会覆盖此处默认模型（DEFAULT_MODEL=deepseek-v4-flash 为占位，
#   接非 OpenAI 服务时请同步改前端模型选择器或经 LLM_MODEL 指定）。
LLM_BASE_URL="https://api.deepseek.com"
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# LLM_MODEL="doubao-seed-2-0-mini-260428"

# =============================================================================
# Embedding 向量化（二选一；维度需与 pgvector 表一致，改维度要重建表）
# -----------------------------------------------------------------------------
# 方式 A：本地 Ollama（qwen3-embedding:0.6b，1024 维）
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b
#
# 方式 B：火山方舟豆包多模态 embedding（doubao-embedding-vision-251215，1024 维）。
#   注意：该模型一次请求只能向量化一条文本（多条 input 会合并成一个向量），
#   代码已按条请求 + 8 并发池补偿吞吐。
EMBEDDING_PROVIDER=ark
EMBEDDING_API_KEY="ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxx"
EMBEDDING_MODEL="doubao-embedding-vision-251215"
EMBEDDING_DIMENSIONS=1024
# EMBEDDING_API_URL=https://ark.cn-beijing.volces.com/api/v3   # 可选覆盖（本地 mock 联调用）
# EMBEDDING_BASE_URL=http://localhost:11434                    # 仅 ollama 方式用

# =============================================================================
# 百度 OCR（PDF 扫描页识别，见 packages/ai-engine/src/loaders/pdf/baidu.ts）
# 百度智能云「文字识别」控制台创建应用获取 API Key / Secret Key
BAIDU_OCR_API_KEY="your-baidu-ocr-api-key"
BAIDU_OCR_SECRET_KEY="your-baidu-ocr-secret-key"

# =============================================================================
# Unstructured Transform v2 云 API（PDF 版面分析，见 loaders/pdf/unstructured.ts）
# 控制台 https://transform.unstructured.io 的「API Keys」获取
UNSTRUCTURED_API_KEY="your-unstructured-api-key"

# =============================================================================
# 图片语义化（PDF 内嵌流程图/架构图 → 结构化描述插回页文本）
# -----------------------------------------------------------------------------
# provider=none（默认）完全关闭；provider=ark 且 IMAGE_VLM_API_KEY 非空即启用。
# 当前示例：火山方舟 Doubao-Seed-2.0-mini（多模态，开通即调，无需推理接入点）；
# IMAGE_VLM_API_URL 留空走默认 ark endpoint，也可覆盖为任意 OpenAI 兼容端点。
IMAGE_VLM_PROVIDER=none          # none（关闭）| ark
IMAGE_VLM_API_KEY="ark-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxx"
# IMAGE_VLM_API_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_VLM_MODEL="doubao-seed-2-0-mini-260428"
# IMAGE_VLM_MAX_IMAGES=20        # 单文档最多语义化图片数
# IMAGE_VLM_CONCURRENCY=3        # 并发调用数
# IMAGE_VLM_TIMEOUT_MS=30000     # 单图调用超时
