DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/langchain_rag"

# ============ LLM 问答（二选一）============
# 方式 A：OpenAI 兼容接口（DeepSeek / OpenAI）
# 通用Deepseek、openai 都用这个变量
LLM_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 方式 B：本地 Ollama（qwen3.5:0.8b，需本机运行 Ollama 并拉取模型）
# 设置 LLM_PROVIDER=ollama 后走 ChatOllama 原生接口并关闭思考模式，
# LLM_BASE_URL 指向本机 11434、OPENAI_API_KEY 填任意非空占位即可
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=ollama
# OLLAMA_MODEL=qwen3.5:0.8b

# 百度 OCR（PDF 解析使用，见 packages/ai-engine/src/loaders/pdf.baidu.loader.ts）
BAIDU_OCR_API_KEY=your-baidu-ocr-api-key
BAIDU_OCR_SECRET_KEY=your-baidu-ocr-secret-key